item_matches [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#17266d" COLSPAN="2"><FONT COLOR="white"><B>item_matches</B></FONT></TD></TR><TR><TD PORT="match_id" ALIGN="LEFT">PK match_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="lost_item_id" ALIGN="LEFT">FK lost_item_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="found_item_id" ALIGN="LEFT">FK found_item_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="match_score" ALIGN="LEFT"> match_score ?</TD><TD ALIGN="LEFT">decimal(5,2)</TD></TR><TR><TD PORT="match_status" ALIGN="LEFT"> match_status !</TD><TD ALIGN="LEFT">enum</TD></TR><TR><TD PORT="confirmed_by_user_id" ALIGN="LEFT">FK confirmed_by_user_id ?</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9">UQ (lost_item_id, found_item_id)</FONT></TD></TR></TABLE>>];
