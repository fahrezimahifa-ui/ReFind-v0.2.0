notifications [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#17266d" COLSPAN="2"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR><TR><TD PORT="notification_id" ALIGN="LEFT">PK notification_id !</TD><TD ALIGN="LEFT">bigint(20) unsigned</TD></TR><TR><TD PORT="user_id" ALIGN="LEFT">FK user_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="claim_id" ALIGN="LEFT">FK claim_id ?</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="item_id" ALIGN="LEFT">FK item_id ?</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="notification_type" ALIGN="LEFT"> notification_type !</TD><TD ALIGN="LEFT">varchar(50)</TD></TR><TR><TD PORT="is_read" ALIGN="LEFT"> is_read !</TD><TD ALIGN="LEFT">tinyint(1)</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#17266d" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT">PK user_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="student_id" ALIGN="LEFT">UQ student_id ?</TD><TD ALIGN="LEFT">varchar(30)</TD></TR><TR><TD PORT="full_name" ALIGN="LEFT"> full_name !</TD><TD ALIGN="LEFT">varchar(120)</TD></TR><TR><TD PORT="email" ALIGN="LEFT">UQ email !</TD><TD ALIGN="LEFT">varchar(150)</TD></TR><TR><TD PORT="password_hash" ALIGN="LEFT"> password_hash !</TD><TD ALIGN="LEFT">varchar(255)</TD></TR><TR><TD PORT="role" ALIGN="LEFT"> role !</TD><TD ALIGN="LEFT">enum</TD></TR><TR><TD PORT="is_active" ALIGN="LEFT"> is_active !</TD><TD ALIGN="LEFT">tinyint(1)</TD></TR></TABLE>>];
