digraph ERD {
graph [rankdir=LR, splines=polyline, ranksep=1.1, nodesep=0.45, bgcolor="white", pad=0.4, fontname="Arial", fontsize=15, labelloc=t, label="ERD01 · Operational relations · As-built / B06\n14 actual tables; ! NOT NULL / ? nullable; REF = other sheet; full fields/constraints in dictionary"];
