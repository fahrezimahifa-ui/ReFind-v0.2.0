digraph ERD {
graph [rankdir=LR, splines=polyline, ranksep=1.1, nodesep=0.45, bgcolor="white", pad=0.4, fontname="Arial", fontsize=15, labelloc=t, label="ERD02 · Reference / location relations · As-built / B06\n14 actual tables; ! NOT NULL / ? nullable; REF = other sheet; full fields/constraints in dictionary"];
node [shape=plain, fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=9, color="#64748b", arrowsize=0.65];
buildings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#17266d" COLSPAN="2"><FONT COLOR="white"><B>buildings</B></FONT></TD></TR><TR><TD PORT="building_id" ALIGN="LEFT">PK building_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="building_name" ALIGN="LEFT">UQ building_name !</TD><TD ALIGN="LEFT">varchar(120)</TD></TR></TABLE>>];
campus_locations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#17266d" COLSPAN="2"><FONT COLOR="white"><B>campus_locations</B></FONT></TD></TR><TR><TD PORT="location_id" ALIGN="LEFT">PK location_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="location_code" ALIGN="LEFT">UQ location_code ?</TD><TD ALIGN="LEFT">varchar(40)</TD></TR><TR><TD PORT="location_name" ALIGN="LEFT"> location_name !</TD><TD ALIGN="LEFT">varchar(120)</TD></TR><TR><TD PORT="location_kind" ALIGN="LEFT"> location_kind !</TD><TD ALIGN="LEFT">enum</TD></TR><TR><TD PORT="is_active" ALIGN="LEFT"> is_active !</TD><TD ALIGN="LEFT">tinyint(1)</TD></TR><TR><TD PORT="building_id" ALIGN="LEFT">FK building_id ?</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9">UQ (location_name, building_id)</FONT></TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#17266d" COLSPAN="2"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD PORT="category_id" ALIGN="LEFT">PK category_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="category_name" ALIGN="LEFT">UQ category_name !</TD><TD ALIGN="LEFT">varchar(80)</TD></TR><TR><TD PORT="is_active" ALIGN="LEFT"> is_active !</TD><TD ALIGN="LEFT">tinyint(1)</TD></TR></TABLE>>];
handovers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#17266d" COLSPAN="2"><FONT COLOR="white"><B>handovers [REF]</B></FONT></TD></TR><TR><TD PORT="handover_id" ALIGN="LEFT">PK handover_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="claim_id" ALIGN="LEFT">FK/UQ claim_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="pickup_location_id" ALIGN="LEFT">FK pickup_location_id ?</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="handled_by_user_id" ALIGN="LEFT">FK handled_by_user_id ?</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR></TABLE>>];
items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#17266d" COLSPAN="2"><FONT COLOR="white"><B>items [REF]</B></FONT></TD></TR><TR><TD PORT="item_id" ALIGN="LEFT">PK item_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="reporter_user_id" ALIGN="LEFT">FK reporter_user_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="category_id" ALIGN="LEFT">FK category_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="location_id" ALIGN="LEFT">FK location_id ?</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="location_floor_id" ALIGN="LEFT">FK location_floor_id ?</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="status_id" ALIGN="LEFT">FK status_id !</TD><TD ALIGN="LEFT">tinyint(3) unsigned</TD></TR></TABLE>>];
location_floors [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#17266d" COLSPAN="2"><FONT COLOR="white"><B>location_floors</B></FONT></TD></TR><TR><TD PORT="location_floor_id" ALIGN="LEFT">PK location_floor_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="location_id" ALIGN="LEFT">FK location_id !</TD><TD ALIGN="LEFT">int(10) unsigned</TD></TR><TR><TD PORT="floor_name" ALIGN="LEFT"> floor_name !</TD><TD ALIGN="LEFT">varchar(50)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9">UQ (location_id, floor_name)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9">UQ (location_floor_id, location_id)</FONT></TD></TR></TABLE>>];
buildings -> campus_locations [id="fk_location_building", label="1:M · building_id\nparent/child 0..1; children/parent 0..M", dir=both, arrowtail=odottee, arrowhead=odotcrow];
campus_locations -> location_floors [id="fk_floor_location", label="1:M · location_id\nparent/child 1; children/parent 0..M", dir=both, arrowtail=teetee, arrowhead=odotcrow];
categories -> items [id="fk_items_category", label="1:M · category_id\nparent/child 1; children/parent 0..M", dir=both, arrowtail=teetee, arrowhead=odotcrow];
location_floors -> items [id="fk_items_floor_location", label="1:M · location_floor_id, location_id\nparent/child 0..1; children/parent 0..M", dir=both, arrowtail=odottee, arrowhead=odotcrow];
campus_locations -> items [id="fk_items_location", label="1:M · location_id\nparent/child 0..1; children/parent 0..M", dir=both, arrowtail=odottee, arrowhead=odotcrow];
campus_locations -> handovers [id="fk_handover_location", label="1:M · pickup_location_id\nparent/child 0..1; children/parent 0..M", dir=both, arrowtail=odottee, arrowhead=odotcrow];
}